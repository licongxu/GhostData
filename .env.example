DAYTONA_TARGET=eu

# auto (default): Codex SDK with ChatGPT login credits, else pandas fallback
# codex: require Codex; fail if ChatGPT login is missing
# deterministic: demo-only pandas script (no model)
GHOSTDATA_ANALYST=auto
